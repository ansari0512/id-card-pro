rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isLoggedIn() {
      return request.auth != null;
    }

    function isSchoolOwner(schoolId) {
      return request.auth != null && request.auth.uid == schoolId;
    }

    function validStudentData() {
      return request.resource.data.name is string &&
             request.resource.data.name.size() > 0 &&
             request.resource.data.name.size() <= 100 &&
             request.resource.data.father is string &&
             request.resource.data.father.size() > 0 &&
             request.resource.data.class is string &&
             request.resource.data.class.size() > 0 &&
             request.resource.data.section is string &&
             request.resource.data.section.size() > 0 &&
             request.resource.data.mobile is string &&
             request.resource.data.mobile.matches('^[0-9]{10}$') &&
             request.resource.data.schoolId is string &&
             request.resource.data.schoolId.size() > 0;
    }

    function validTeacherData() {
      return request.resource.data.name is string &&
             request.resource.data.name.size() > 0 &&
             request.resource.data.name.size() <= 100 &&
             request.resource.data.designation is string &&
             request.resource.data.designation.size() > 0 &&
             request.resource.data.fatherName is string &&
             request.resource.data.fatherName.size() > 0 &&
             request.resource.data.dob is string &&
             request.resource.data.dob.size() > 0 &&
             request.resource.data.mobile is string &&
             request.resource.data.mobile.matches('^[0-9]{10}$');
    }

    function validPendingStudentData() {
      return request.resource.data.name is string &&
             request.resource.data.name.size() > 0 &&
             request.resource.data.name.size() <= 100 &&
             request.resource.data.class is string &&
             request.resource.data.class.size() > 0;
    }

    // Check if school has any locked students
    // lockedStudentIds is an array of student display IDs like ["SCH-2026-0001", "SCH-2026-0005"]
    function hasLockedStudents(schoolId) {
      let schoolDoc = get(/databases/$(database)/documents/schools/$(schoolId)).data;
      return schoolDoc.lockedStudentIds is list &&
             schoolDoc.lockedStudentIds.size() > 0;
    }

    // Check if a specific student is locked for a school
    function isStudentLockedById(schoolId, studentId) {
      let schoolDoc = get(/databases/$(database)/documents/schools/$(schoolId)).data;
      return schoolDoc.lockedStudentIds is list &&
             studentId in schoolDoc.lockedStudentIds;
    }

    // ── Users ──────────────────────────────────────────────
    match /users/{uid} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── Schools ────────────────────────────────────────────
    match /schools/{schoolId} {
      allow read:  if isLoggedIn() && (isAdmin() || isSchoolOwner(schoolId));
      allow write: if isAdmin();

      // ── Pending Students subcollection ────────────────
      match /pending_students/{studentId} {
        allow read:  if isLoggedIn() && (isAdmin() || isSchoolOwner(schoolId));
        allow create: if isLoggedIn() && isSchoolOwner(schoolId) && validPendingStudentData();
        allow update: if isLoggedIn() && (isAdmin() || isSchoolOwner(schoolId)) && validPendingStudentData();
        allow delete: if isLoggedIn() && (isAdmin() || isSchoolOwner(schoolId));
      }

      // ── ID Counters subcollection ─────────────────────
      // Only allow known fields (count, teacherCount) with non-negative numbers
      // Each field is optional — allow writing only count or only teacherCount
      match /counters/{year} {
        allow read: if isLoggedIn() && (isAdmin() || isSchoolOwner(schoolId));
        allow write: if isLoggedIn() && (isAdmin() || isSchoolOwner(schoolId)) &&
          request.resource.data.keys().hasOnly(['count', 'teacherCount']) &&
          (
            (!('count' in request.resource.data) || (request.resource.data.count is number && request.resource.data.count >= 0)) &&
            (!('teacherCount' in request.resource.data) || (request.resource.data.teacherCount is number && request.resource.data.teacherCount >= 0))
          );
      }

        // ── Teachers subcollection ──────────────────────────
        match /teachers/{teacherId} {
          allow read: if isLoggedIn() && (isAdmin() || isSchoolOwner(schoolId));
          allow create: if isLoggedIn() && (isAdmin() || isSchoolOwner(schoolId)) && validTeacherData();
          // School cannot update/delete if their school has any locked students
          allow update: if isLoggedIn() && (isAdmin() || (isSchoolOwner(schoolId) && !hasLockedStudents(schoolId))) && validTeacherData();
          allow delete: if isLoggedIn() && (isAdmin() || (isSchoolOwner(schoolId) && !hasLockedStudents(schoolId)));
        }

      // ── Classes subcollection ──────────────────────────
      match /classes/{className} {
        allow read:  if isLoggedIn() && (isAdmin() || isSchoolOwner(schoolId));
        allow write: if isLoggedIn() && (isAdmin() || isSchoolOwner(schoolId));

        // ── Students subcollection ─────────────────────
        match /students/{studentId} {
          allow read: if isLoggedIn() && (isAdmin() || isSchoolOwner(schoolId));

          allow create: if isLoggedIn() &&
            (isAdmin() || isSchoolOwner(schoolId)) &&
            validStudentData() &&
            request.resource.data.class == className &&
            request.resource.data.schoolId == schoolId;

          // School cannot update if this student is locked by admin
          allow update: if isLoggedIn() &&
            (isAdmin() || (isSchoolOwner(schoolId) && !isStudentLockedById(schoolId, resource.data.id))) &&
            validStudentData() &&
            request.resource.data.schoolId == resource.data.schoolId;

          // School cannot delete if this student is locked by admin
          allow delete: if isLoggedIn() &&
            (isAdmin() || (isSchoolOwner(schoolId) && !isStudentLockedById(schoolId, resource.data.id)));
        }
      }
    }

    // ── Deleted Schools (Recycle Bin) ─────────────────────────
    match /deleted_schools/{schoolId} {
      // Admin: full access
      allow read, write, delete: if isAdmin();
      
      // List allowed for admin only
      allow list: if isAdmin();
    }

    // ── Deleted Students (Recycle Bin) ────────────────────────
    match /deleted_students/{studentId} {
      // Admin: full access
      allow read, write, delete: if isAdmin();
      
      // School: can ONLY create (soft delete), cannot read/restore/permanent delete
      allow create: if isLoggedIn() && 
        request.auth.uid == request.resource.data.schoolId &&
        request.resource.data.deletedByRole == 'school';
      
      // List allowed for admin only
      allow list: if isAdmin();
    }

    // ── Deleted Teachers (Recycle Bin) ────────────────────────
    match /deleted_teachers/{teacherId} {
      // Admin: full access
      allow read, write, delete: if isAdmin();
      
      // School: can ONLY create (soft delete)
      allow create: if isLoggedIn() && 
        request.auth.uid == request.resource.data.schoolId &&
        request.resource.data.deletedByRole == 'school';
      
      // List allowed for admin only
      allow list: if isAdmin();
    }

    // ── Deleted Pending Students (Recycle Bin) ─────────────────
    match /deleted_pending_students/{studentId} {
      // Admin: full access
      allow read, write, delete: if isAdmin();
      
      // School: can ONLY create (soft delete)
      allow create: if isLoggedIn() && 
        request.auth.uid == request.resource.data.schoolId &&
        request.resource.data.deletedByRole == 'school';
      
      // List allowed for admin only
      allow list: if isAdmin();
    }
  }
}
