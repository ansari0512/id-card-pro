rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── STUDENT PHOTOS: New path with school ID isolation ────────────
    // Path: student_photos/{schoolId}/{schoolName}/{className}/{fileName}
    // Any authenticated user can upload (app logic controls access)
    // Size: max 5MB, Type: images only
    match /student_photos/{schoolId}/{schoolName}/{className}/{fileName} {
      allow read:   if request.auth != null;
      allow write:  if request.auth != null &&
                     request.resource.size < 5 * 1024 * 1024 &&
                     request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // ── STUDENT PHOTOS: Old path backward compatibility ─────────────
    // Path: student_photos/{schoolName}/{className}/{fileName}
    // Existing photos remain readable by any authenticated user
    // No new uploads allowed to this path
    match /student_photos/{schoolName}/{className}/{fileName} {
      allow read:   if request.auth != null;
      allow write:  if false;
      allow delete: if request.auth != null;
    }

    // ── TEACHER PHOTOS: New path with school ID isolation ────────────
    // Path: teacher_photos/{schoolId}/{schoolName}/{fileName}
    // Any authenticated user can upload (app logic controls access)
    // Size: max 5MB, Type: images only
    match /teacher_photos/{schoolId}/{schoolName}/{fileName} {
      allow read:   if request.auth != null;
      allow write:  if request.auth != null &&
                     request.resource.size < 5 * 1024 * 1024 &&
                     request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // ── TEACHER PHOTOS: Old path backward compatibility ─────────────
    // Path: teacher_photos/{schoolName}/{fileName}
    match /teacher_photos/{schoolName}/{fileName} {
      allow read:   if request.auth != null;
      allow write:  if false;
      allow delete: if request.auth != null;
    }
  }
}