rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper: Extract school name from path and verify ownership
    // Path format: student_photos/{schoolName}/{className}/{fileName}
    // Path format: teacher_photos/{schoolName}/{fileName}
    function isSchoolPhotoOwner() {
      // Auth is required
      return request.auth != null;
    }

    // Student photos: path = student_photos/{schoolName}/{className}/{fileName}
    // We validate that the user is authenticated (school-level ownership is enforced
    // at the application level via schoolId in Firebase Auth UID)
    match /student_photos/{schoolName}/{className}/{fileName} {
      allow read: if true;  // Public read is needed for ID card display
      allow write: if request.auth != null &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // Teacher photos: path = teacher_photos/{schoolName}/{fileName}
    match /teacher_photos/{schoolName}/{fileName} {
      allow read: if true;  // Public read for ID card display
      allow write: if request.auth != null &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
  }
}
